{"seq": 47, "round": 2, "kind": "patch_accepted", "key": "sqli:GET /notes/search", "attempt": 1, "rationale": "Uses a parameterised query so user input is never parsed as SQL, and removes the keyword check.", "author": "reference", "edits": [{"old": "        if \" OR \" in q:\n            raise HTTPException(status_code=400, detail=\"invalid query\")\n", "new": ""}, {"old": "        sql = (\n            \"SELECT id, title, body FROM notes \"\n            f\"WHERE owner_id = {user['id']} AND title LIKE '%{q}%'\"\n        )\n        rows = conn.execute(sql).fetchall()\n", "new": "        rows = conn.execute(\n            \"SELECT id, title, body FROM notes WHERE owner_id = ? AND title LIKE ?\",\n            (user[\"id\"], f\"%{q}%\"),\n        ).fetchall()\n"}]}
{"seq": 48, "round": 2, "kind": "patch_accepted", "key": "path_traversal:GET /files", "attempt": 1, "rationale": "Resolves the real path and refuses anything outside the public directory.", "author": "reference", "edits": [{"old": "        name = name.replace(\"../\", \"\")\n        path = os.path.join(data_dir, \"public\", name)\n", "new": "        base = os.path.realpath(os.path.join(data_dir, \"public\"))\n        path = os.path.realpath(os.path.join(base, name))\n        if not path.startswith(base + os.sep):\n            raise HTTPException(status_code=404, detail=\"no such file\")\n"}]}
