{"seq": 52, "round": 2, "kind": "patch_accepted", "key": "sqli:GET /books/search", "attempt": 1, "rationale": "Binds the search term as a query parameter instead of pasting it into the SQL text. Removes the naive OR check.", "author": "reference", "edits": [{"old": "        # sqli: a naive guard against the capitalised word OR\n        if \" OR \" in q:\n            raise HTTPException(status_code=400, detail=\"invalid search\")\n", "new": ""}, {"old": "        # sqli: the term is pasted into the SQL text with str.format, not bound as a parameter\n        sql = \"SELECT id, title, notes FROM books WHERE staff_only = 0 AND title LIKE '%{}%'\"\n        rows = self.conn.execute(sql.format(term)).fetchall()\n", "new": "        rows = self.conn.execute(\n            \"SELECT id, title, notes FROM books WHERE staff_only = 0 AND title LIKE ?\",\n            (\"%\" + term + \"%\",),\n        ).fetchall()\n"}]}
{"seq": 53, "round": 2, "kind": "patch_accepted", "key": "path_traversal:GET /covers", "attempt": 1, "rationale": "Resolves the path and reads only files inside the covers folder. Removes the naive strip.", "author": "reference", "edits": [{"old": "        # path_traversal: a naive strip of dot-dot-slash from the name\n        name = name.replace(\"../\", \"\")\n", "new": ""}, {"old": "    # path_traversal: the name is joined onto the folder and read with no containment check\n    path = covers_dir / name\n", "new": "    # path_traversal: the resolved path must stay inside the covers folder\n    base = covers_dir.resolve()\n    path = (base / name).resolve()\n    if base not in path.parents:\n        raise FileNotFoundError(name)\n"}]}
{"seq": 54, "round": 2, "kind": "patch_accepted", "key": "auth_bypass:GET /staff/report", "attempt": 1, "rationale": "Stops trusting the as_member cookie altogether; the member comes only from the token. Removes the naive cookie check.", "author": "reference", "edits": [{"old": "        # auth_bypass: a naive guard that refuses the exact staff cookie\n        if raw_cookie == \"as_member=staff\":\n            raise HTTPException(status_code=403, detail=\"cookie not allowed\")\n", "new": ""}, {"old": "        # auth_bypass: a caller-supplied as_member cookie is trusted as the member it names\n        raw_cookie = request.headers.get(\"cookie\", \"\")\n        impersonated = cookie_member(raw_cookie)\n        if impersonated:\n            member = repo.member_by_name(impersonated)\n            if member is not None:\n                return member\n", "new": ""}]}
